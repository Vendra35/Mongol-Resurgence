situation_panel = {

    ##################################### TOP HEADER (SINGLE PORTRAIT - THE KHAGHAN) #####################################
    # one_country_header_template receives its country via a block named
    # "CountryContext" and its anchor via "character_portrait_anchor"
    # (country_header.gui:156/:160) — the First*/first_* names belong to
    # the TWO-country template only. Overriding the wrong names left the
    # portrait black with "No context supplied ... Character" log spam.
    #
    # Deliberately the ONE-country header, not the dual portrait Phase 1
    # uses. There is no single rival here: the empire is coming apart
    # into six successors at once, and picking one of them to stand
    # opposite the Khaghan would misrepresent what is happening. The
    # cohesion bar carries the drama instead.
    blockoverride "situation_panel_image" {
        using = one_country_header_template

        blockoverride "CountryContext" {
            datacontext = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('mr_leading_country').GetCountry]"
        }

        blockoverride "character_portrait_anchor" {
            parentanchor = bottom|left
        }

        # Hides the ruler-title strip beside the portrait. See the long
        # note in mongol_dominance.gui: one_country_header_template
        # declares "CountryContext" twice and a single blockoverride
        # replaces both, handing the strip a Country where it wants a
        # Government. Vanilla does the same in reformation.gui:88.
        blockoverride "one_country_ruler_title_visible" {
            visible = no
        }

        blockoverride "character_religion_visibility" {
            visible = no
        }

        blockoverride "character_name_maximumsize" {
            maximumsize = { 270 -1 }
        }
    }

    ##################################### MAIN CONTENT #####################################
    blockoverride "situation_panel_main_content" {
        vbox = {
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            margin_left = 15
            margin_right = 15
            margin_bottom = 10
            margin_top = -10
            spacing = 8

            # CARD 1: SITUATION DESCRIPTION
            situation_card_expandable = {
                blockoverride "header_button_onclick" {
                    onclick = "[LateralView.Vars.Toggle( 'mr_partition_desc_toggled' )]"
                }
                blockoverride "header_text" {
                    text = "situation_mr_great_partition_title"
                }
                blockoverride "header_icon" {
                    texture = "gfx/interface/icons/traits/_default.dds"
                }
                blockoverride "bottom_content" {
                    text_multi = {
                        margin = { 15 10 }
                        layoutpolicy_horizontal = expanding
                        max_width = 460
                        autoresize = yes
                        text = "situation_mr_great_partition_desc"
                    }
                }
                blockoverride "bottom_content_onclick" {
                    visible = "[LateralView.Vars.Exists( 'mr_partition_desc_toggled' )]"
                }
                blockoverride "icon_replace_visible_yes" {
                    visible = "[LateralView.Vars.Exists( 'mr_partition_desc_toggled' )]"
                }
                blockoverride "icon_replace_visible_not" {
                    visible = "[Not(LateralView.Vars.Exists( 'mr_partition_desc_toggled' ))]"
                }
            }

            # CARD 2: END CONDITIONS
            situation_card_expandable = {
                blockoverride "header_button_onclick" {
                    onclick = "[LateralView.Vars.Toggle( 'mr_partition_req_toggled' )]"
                }
                blockoverride "header_text" {
                    text = "END_REQUIREMENTS"
                }
                blockoverride "header_icon" {
                    texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
                }
                blockoverride "bottom_content" {
                    TooltipRequirementsList = {
                        textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
                        margin = { 15 10 }
                    }
                }
                blockoverride "bottom_content_onclick" {
                    visible = "[LateralView.Vars.Exists( 'mr_partition_req_toggled' )]"
                }
                blockoverride "icon_replace_visible_yes" {
                    visible = "[LateralView.Vars.Exists( 'mr_partition_req_toggled' )]"
                }
                blockoverride "icon_replace_visible_not" {
                    visible = "[Not(LateralView.Vars.Exists( 'mr_partition_req_toggled' ))]"
                }
            }

            # CARD 3: COHESION
            situation_card_expandable = {
                blockoverride "header_button_onclick" {
                    onclick = "[LateralView.Vars.Toggle( 'mr_partition_cohesion_toggled' )]"
                }
                blockoverride "header_text" {
                    text = "mr_great_partition_progress_tooltip"
                }
                blockoverride "header_icon" {
                    texture = "gfx/interface/icons/disasters/end_requirements_green.dds"
                }
                blockoverride "bottom_content" {
                    vbox = {
                        margin = { 15 10 }
                        spacing = 5
                        layoutpolicy_horizontal = expanding

                        # This bar counts DOWN, unlike every other panel in
                        # the mod: 100 is an empire that still holds every
                        # ulus, and the successors break away as it falls
                        # past their thresholds. GetValue is wrapped in
                        # FixedPointToFloat because value takes a float and
                        # a script variable reads back as fixed-point — the
                        # bare call silently resolves to 0, which is what
                        # kept the other two bars empty for the whole
                        # project. italian_wars.gui:326 is the same
                        # construct on a situation variable.
                        text_single = {
                            name = "cohesion_label"
                            layoutpolicy_horizontal = expanding
                            text = "MR_COHESION_SCORE_TT"
                        }

                        progressbar = {
                            name = "partition_cohesion"
                            size = { 380 24 }
                            using = morale_progressbar_bar
                            min = 0
                            max = 100
                            value = "[FixedPointToFloat(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('MR_cohesion_score').GetValue)]"
                            tooltip = "mr_great_partition_progress_tooltip"
                        }
                    }
                }
                blockoverride "bottom_content_onclick" {
                    visible = "[LateralView.Vars.Exists( 'mr_partition_cohesion_toggled' )]"
                }
                blockoverride "icon_replace_visible_yes" {
                    visible = "[LateralView.Vars.Exists( 'mr_partition_cohesion_toggled' )]"
                }
                blockoverride "icon_replace_visible_not" {
                    visible = "[Not(LateralView.Vars.Exists( 'mr_partition_cohesion_toggled' ))]"
                }
            }

            # Zeroes out the gap below
            expand = {}
        }
    }
}
