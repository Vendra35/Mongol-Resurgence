situation_panel = {

	##################################### SUBHEADER #####################################

	blockoverride "situation_subheader_content" {}

	##################################### MAIN CONTENT #####################################

	# 1.4: vanilla draws the Outcomes card above the main content from the
	# situation's outcome blocks (common.gui situation_outcomes); this puts
	# the hint button on each outcome, as vanilla's 23 panels do. It
	# replaces 1.3's End Requirements card, which read GetEndConditions.
	blockoverride "situation_panel_outcome_hint" {
		action_tooltip = {
			title = "OPEN_HINT"
			on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_mr_torghut')]"
		}
	}

}
